# Copy this file to .env and fill in real values (.env is gitignored)
# Notion internal integration secret: https://www.notion.so/profile/integrations
NOTION_TOKEN=
# Token MCP clients must present to this server (e.g. openssl rand -hex 32)
MCP_AUTH_TOKEN=

# Optional:
# NOTION_VERSION=2022-06-28
# Optional. Empty = allow any browser origin. Wildcards OK, include scheme:
# ALLOWED_ORIGINS=https://*.hf.space
# ALLOW_QUERY_TOKEN=false
